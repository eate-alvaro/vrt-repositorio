# ---------------------------------------------------------------------------
# Configuracion de entorno - Paintball VR & IoT
# Copia este archivo como ".env" y ajusta los valores.
# ---------------------------------------------------------------------------

# Django
DJANGO_SECRET_KEY=dev-insecure-change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# Firebase Realtime Database
FIREBASE_DB_URL=https://alvin-59045-default-rtdb.firebaseio.com/
# Opcional: secreto heredado o token de acceso para reglas cerradas.
FIREBASE_DB_SECRET=
FIREBASE_TIMEOUT=8
FIREBASE_USERS_NODE=users

# Identidad de la aplicacion
VRT_APP_NAME=PAINTBALL VR & IOT
VRT_APP_TAGLINE=PLATAFORMA DE SIMULACION
VRT_APP_VERSION=1.0.0
